{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bombombini Gusini",
  "version": "0.1.0",
  "identifier": "com.bombombini.gusini",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bombombini Gusini",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
