{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bombombini Gusini",
  "version": "0.2.0",
  "identifier": "com.bombombini.gusini",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bombombini Gusini",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "visible": false
      }
    ]
  },
  "security": {
    "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https: wss: ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-eval'"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
