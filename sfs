local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "TransitionUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = PlayerGui

-- Nền đen
local black = Instance.new("Frame")
black.Parent = gui
black.Size = UDim2.new(1,0,1,0)
black.BackgroundColor3 = Color3.new(0,0,0)
black.BackgroundTransparency = 1
black.BorderSizePixel = 0

-- Chữ chạy
local text = Instance.new("TextLabel")
text.Parent = gui
text.BackgroundTransparency = 1
text.Size = UDim2.new(0,900,0,45)
text.AnchorPoint = Vector2.new(0.5,0.5)
text.Position = UDim2.new(-0.6,0,0.5,0)
text.Font = Enum.Font.GothamBold
text.TextSize = 30
text.TextStrokeTransparency = 0
text.TextStrokeColor3 = Color3.new(0,0,0)
text.Visible = false

-- Chữ đổi màu cầu vồng
task.spawn(function()
	local hue = 0
	while true do
		hue = (hue + 0.005) % 1
		text.TextColor3 = Color3.fromHSV(hue,1,1)
		task.wait(0.03)
	end
end)

local messages = {
	"CHUC BAN CHOI GAME VUI VE",
	"SCRIPT DANG HOAT DONG",
	"━━━━━━━━━━━━━━━━━━━━",
	"CREDIT: MINH DEO GAY",
	"━━━━━━━━━━━━━━━━━━━━",
	"CAM ON BAN DA SU DUNG SCRIPT"
}

while true do
	-- Fade nền đen
	TweenService:Create(
		black,
		TweenInfo.new(0.5),
		{BackgroundTransparency = 0}
	):Play()

	task.wait(0.6)

	text.Visible = true

	for _,msg in ipairs(messages) do
		text.Text = msg
		text.Position = UDim2.new(-0.6,0,0.5,0)

		local move = TweenService:Create(
			text,
			TweenInfo.new(6,Enum.EasingStyle.Linear),
			{Position = UDim2.new(1.6,0,0.5,0)}
		)

		move:Play()
		move.Completed:Wait()
		task.wait(0.3)
	end

	text.Visible = false

	-- Fade về trong suốt
	TweenService:Create(
		black,
		TweenInfo.new(0.5),
		{BackgroundTransparency = 1}
	):Play()

	task.wait(300) -- 5 phút
end
